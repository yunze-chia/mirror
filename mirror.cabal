cabal-version:      3.4
name:               mirror
version:            0.1.0.0
build-type:         Simple
extra-doc-files:    README.md

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:
        Lib.Types,
        Lib.Portfolio
    -- other-modules:
    -- other-extensions:
    build-depends:
        base ^>=4.18.0.0,
        time,
        cassava,
        containers
    hs-source-dirs:   src

executable mirror
    import:           warnings
    main-is:          Main.hs
    other-modules:
        App.Options
    -- other-extensions:
    build-depends:
        base ^>=4.18.0.0,
        mirror,
        time,
        cassava,
        bytestring,
        optparse-applicative
    hs-source-dirs:   app

test-suite mirror-test
    import:           warnings
    -- other-modules:
    -- other-extensions:
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Main.hs
    build-depends:
        base ^>=4.18.0.0,
        mirror
